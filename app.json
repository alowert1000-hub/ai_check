{
  "expo": {
    "name": "역검연습",
    "slug": "ai-check",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "aicheck",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF6F0"
    },
    "ios": {
      "supportsTablet": true,
      "isTabletOnly": false,
      "requireFullScreen": false,
      "bundleIdentifier": "com.aicheck.practice",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF6F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.aicheck.practice"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "역검연습",
      "shortName": "역검연습",
      "lang": "ko",
      "description": "잡다 신역검 전략게임 9종을 아이폰·아이패드에서 연습하는 앱",
      "themeColor": "#FFF6F0",
      "backgroundColor": "#FFF6F0",
      "display": "standalone",
      "orientation": "any",
      "startUrl": ".",
      "barStyle": "default",
      "preferRelatedApplications": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF6F0",
          "image": "./assets/splash-icon.png"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
